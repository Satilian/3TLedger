{
  "name": "@satilian/3tledger-budgets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm build && dotenvx run -- pnpm server",
    "build": "rsbuild build",
    "dev": "rsbuild dev",
    "dev:server": "concurrently \"pnpm watch\" \"pnpm watch:server\"",
    "watch": "rsbuild build --watch",
    "watch:server": "wait-on dist/server.js && dotenvx run -- node --watch-path=dist dist/server",
    "server": "dotenvx run -- node dist/server"
  },
  "dependencies": {
    "@satilian/plugin-mf": "^1.0.1",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
