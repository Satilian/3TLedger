HTTP_ADDR=127.0.0.1:8081

# PostgreSQL. Спецсимволы в пароле кодируются для URL.
DATABASE_URL=postgres://3tledger_identity:CHANGE_ME@127.0.0.1:5432/3tledger_identity?sslmode=disable

# Keycloak OIDC. Зарегистрируйте OIDC_REDIRECT_URL в настройках клиента.
PUBLIC_BASE_URL=https://localhost:3443
OIDC_ISSUER_URL=https://auth.example.internal/realms/3t_ledger
OIDC_CLIENT_ID=3t_ledger_client
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URL=https://localhost:3443/api/v1/auth/callback
# OIDC_CA_FILE=/etc/ssl/keycloak/ca.crt
