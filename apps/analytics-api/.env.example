HTTP_ADDR=127.0.0.1:8084

# Опционально, при добавлении собственного хранилища.
# DATABASE_URL=postgres://3tledger_analytics:CHANGE_ME@127.0.0.1:5432/3tledger_analytics?sslmode=disable

# Для планируемого подключения Kafka. Адреса брокеров указываются через запятую.
KAFKA_BROKER_HOSTS=localhost:9092
KAFKA_CLIENT_ID=3tledger-analytics-api
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP_ID=3tledger-analytics-api
KAFKA_TOPIC_LEDGER_TRANSACTIONS=ledger.transactions.v1
