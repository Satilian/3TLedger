        <mxCell id="cache" value="&lt;b&gt;Redis · опциональный HTML-кеш&lt;/b&gt;&lt;br&gt;SWR и только маршруты с ssrCache&lt;br&gt;Cookie / Authorization обходят кеш&lt;br&gt;У текущих маршрутов кеш выключен" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#B5A1E0;fontColor=#4B3475;fontFamily=Arial;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="790" y="374" width="330" height="78" as="geometry"/></mxCell>
