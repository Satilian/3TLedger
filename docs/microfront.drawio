        <mxCell id="budgets" value="&lt;b&gt;Budgets&lt;/b&gt;&lt;br&gt;/budgets&lt;br&gt;Планирование бюджета" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#EAF2FF;strokeColor=#9EB9E2;fontColor=#183B69;" vertex="1" parent="1"><mxGeometry x="650" y="273" width="285" height="92" as="geometry"/></mxCell>
