        <mxCell id="overview" value="&lt;b&gt;Сводка бюджета&lt;/b&gt;&lt;br&gt;BudgetSummary, OverallBudget&lt;br&gt;BudgetProgress" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#F5F8FC;strokeColor=#D6E1EF;fontColor=#263E5E;" vertex="1" parent="1"><mxGeometry x="674" y="397" width="261" height="84" as="geometry"/></mxCell>
        <mxCell id="budgets-overview" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#55739D;endArrow=block;endFill=1;exitX=0.03;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="budgets" target="overview"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="658" y="439"/></Array></mxGeometry></mxCell>
        <mxCell id="limits" value="&lt;b&gt;Лимиты по категориям&lt;/b&gt;&lt;br&gt;CategoryBudgetList, CategoryBudgetRow&lt;br&gt;BudgetLimitEditor" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#F5F8FC;strokeColor=#D6E1EF;fontColor=#263E5E;" vertex="1" parent="1"><mxGeometry x="674" y="497" width="261" height="84" as="geometry"/></mxCell>
        <mxCell id="budgets-limits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#55739D;endArrow=block;endFill=1;exitX=0.03;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="budgets" target="limits"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="658" y="539"/></Array></mxGeometry></mxCell>
        <mxCell id="profile" value="&lt;b&gt;Profile&lt;/b&gt;&lt;br&gt;/profile&lt;br&gt;Профиль пользователя" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#EAF2FF;strokeColor=#9EB9E2;fontColor=#183B69;" vertex="1" parent="1"><mxGeometry x="955" y="273" width="285" height="92" as="geometry"/></mxCell>
        <mxCell id="shell-profile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#55739D;endArrow=block;endFill=1;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="shell" target="profile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1097.5" y="241"/></Array></mxGeometry></mxCell>
        <mxCell id="personal" value="&lt;b&gt;Персональные данные&lt;/b&gt;&lt;br&gt;ProfileForm, ProfilePhoto&lt;br&gt;PersonalInfoSection" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#F5F8FC;strokeColor=#D6E1EF;fontColor=#263E5E;" vertex="1" parent="1"><mxGeometry x="979" y="397" width="261" height="84" as="geometry"/></mxCell>
        <mxCell id="profile-personal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#55739D;endArrow=block;endFill=1;exitX=0.03;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="profile" target="personal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="963" y="439"/></Array></mxGeometry></mxCell>
        <mxCell id="shared" value="&lt;b&gt;UI Kit · общая библиотека&lt;/b&gt;&lt;br&gt;Токены, Button, Input, Card, Table, Dialog, Tabs, ProgressBar и примитивы графиков&lt;br&gt;Shell и remote подключают библиотеку при сборке. Компоненты с правилами предметной области принадлежат своим микрофронтам." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#E8F7F0;strokeColor=#9BCEB7;fontColor=#174B38;" vertex="1" parent="1"><mxGeometry x="40" y="611" width="1200" height="76" as="geometry"/></mxCell>
        <mxCell id="contracts" value="&lt;b&gt;Контракты между приложениями&lt;/b&gt;&lt;br&gt;Shell подключает публичные точки входа маршрутов через @satilian/plugin-mf. Каждый remote владеет своими запросами и состоянием.&lt;br&gt;Analytics читает данные для сводок через API. Budgets получает справочник категорий через API. React и React DOM используются совместно." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#E8EFFA;strokeColor=#91A9CD;fontColor=#1D3A63;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="1200" height="76" as="geometry"/></mxCell>
        <mxCell id="migration" value="&lt;b&gt;Порядок внедрения&lt;/b&gt;&lt;br&gt;1. Согласовать контракт маршрута для SSR и браузера, подключить UI Kit и обработку недоступного remote в Shell.&lt;br&gt;2. Подключить существующий apps/ledger, перенести счета, категории и сценарии операций.&lt;br&gt;3. Подключить Analytics и заменить главную страницу на Dashboard. Затем подключить Budgets и Profile." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=14;fontFamily=Arial;fillColor=#F3EEFA;strokeColor=#C9B9DD;fontColor=#493862;" vertex="1" parent="1"><mxGeometry x="40" y="799" width="1200" height="112" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
